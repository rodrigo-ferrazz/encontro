# Copie para .env. Sem a chave, a ferramenta roda só com o grafo local (sem trânsito).
TOMTOM_API_KEY=

# Cota gratuita diária da TomTom (requisições "non-tile").
TOMTOM_DAILY_LIMIT=2500
# 1 = conta cada célula da matriz como uma unidade (conservador); 0 = conta por requisição.
TOMTOM_COUNT_CELLS=1
# Máximo de células por requisição síncrona no plano Freemium.
TOMTOM_MAX_CELLS=200

# ENCONTRO_CACHE_DIR=cache
# ENCONTRO_PLACE=São Paulo, São Paulo, Brazil
# ENCONTRO_HTTP_TIMEOUT=15
# ENCONTRO_MATRIX_TTL=300
